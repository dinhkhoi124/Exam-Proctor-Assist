# Laptop / Windows development: localhost application with API-hosted models.
# Copy to .env and replace every placeholder; never commit the resulting file.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/fpt_exam_support
JWT_SECRET=replace-with-a-long-random-secret
EMAIL_ENCRYPT_KEY=replace-with-a-fernet-key
FRONTEND_URL=http://localhost:8080
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Leave BASE_URL blank for OpenAI. For another OpenAI-compatible API, set its /v1 URL.
OPENAI_API_KEY=replace-with-api-key
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=512
LLM_MAX_CONCURRENCY=2
LLM_TEMPERATURE=0.2
LLM_FREQUENCY_PENALTY=0.25
# API providers generally do not accept vLLM's repetition_penalty extension.
LLM_REPETITION_PENALTY=1.0
VISION_MAX_TOKENS=160
VISION_IMAGE_MAX_DIMENSION=1280
VISION_IMAGE_JPEG_QUALITY=85

# Use API speech-to-text; do not point to the PC's local service at port 8002.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
STT_FALLBACK_MODEL=whisper-1
STT_TIMEOUT_SECONDS=180
STT_LANGUAGE=
VOICE_CORRECTION_ENABLED=true
VOICE_LLM_NORMALIZATION_ENABLED=false

# Keep embeddings/RAG local on the laptop CPU.
EMBEDDING_DEVICE=cpu
EMBEDDING_LOCAL_FILES_ONLY=true
RAG_MAX_CONCURRENCY=2
RAG_MIN_DENSE_SCORE=0.83
RAG_MIN_BM25_SCORE=20.0
RAG_OCR_ENABLED=true
# Enable only when image-only/scanned PDFs must be indexed; rebuilding will be slower.
RAG_OCR_SCAN_EMPTY_PAGES=false

# Local Qwen through an OpenAI-compatible vLLM server.
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=local
LLM_MODEL=qwen3-exam-assist
QUERY_REWRITE_MODEL=qwen3-exam-assist
VISION_BASE_URL=http://127.0.0.1:8001/v1
VISION_API_KEY=local
VISION_MODEL=qwen3-exam-assist
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
LLM_FREQUENCY_PENALTY=0.25
LLM_REPETITION_PENALTY=1.08
VISION_MAX_TOKENS=160
EMBEDDING_DEVICE=cpu
RAG_MIN_DENSE_SCORE=0.83
RAG_MIN_BM25_SCORE=20.0

# Optional legacy OpenAI audio services. Also used as the LLM key when the
# local base URLs above are left empty and the model names are changed.
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_FALLBACK_MODEL=whisper-1
STT_BASE_URL=http://127.0.0.1:8002/v1
STT_API_KEY=local
STT_MODEL=faster-whisper-medium
STT_FALLBACK_MODEL=
STT_TIMEOUT_SECONDS=180
# Leave blank to auto-detect Vietnamese, English, and mixed speech.
STT_LANGUAGE=
VOICE_CORRECTION_ENABLED=true
# Keep false: only deterministic STT fixes run; Qwen never rewrites the voice transcript.
VOICE_LLM_NORMALIZATION_ENABLED=false
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Local CTranslate2 Whisper checkpoint (the launch script supplies its absolute path).
FASTER_WHISPER_MODEL_PATH=../models/faster-whisper-medium
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/fpt_exam_support
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=10
FRONTEND_URL=http://localhost:8080
FRONTEND_ORIGINS=http://localhost:8080
EMAIL_ENCRYPT_KEY=

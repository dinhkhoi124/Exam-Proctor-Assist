{
  "extends": "dataset_benchmark/robustness_v2/configs/local_full_inference_config.json",
  "version": "2.1.0-local-recorded-noise",
  "dataset": {
    "variant_manifest": "dataset_benchmark/robustness_v2/manifests/recorded_noise_generated.jsonl",
    "augmentation_plan": "dataset_benchmark/robustness_v2/manifests/recorded_noise_plan.jsonl",
    "augmentation_config": "dataset_benchmark/robustness_v2/configs/augmentation_recorded_noise_config.json",
    "expected_variants": 650,
    "default_condition": null,
    "default_base_limit": null,
    "pilot_max_base": 130,
    "maximum_base": 130
  },
  "evaluation": {
    "primary_evidence_filter": {
      "split": "test",
      "noise_mode": "external_asset",
      "conditions": ["C1", "C2", "C3"],
      "expected_variants_per_pipeline": 416
    },
    "secondary_evidence": {
      "clean_c0": true,
      "development_split": true,
      "synthetic_run": "historical_only_not_pooled"
    },
    "cluster_units": ["base_id", "noise_source_recording_id"]
  },
  "outputs": {
    "run_manifest": "dataset_benchmark/robustness_v2/manifests/pipeline_recorded_noise_manifest.jsonl",
    "cache_dir": "dataset_benchmark/robustness_v2/cache_recorded_noise",
    "checkpoint_dir": "dataset_benchmark/robustness_v2/checkpoints_recorded_noise",
    "threshold_tuning": "dataset_benchmark/robustness_v2/reports_recorded_noise/selective_threshold_tuning.json",
    "evaluation_summary": "dataset_benchmark/robustness_v2/reports_recorded_noise/robustness_v2_recorded_noise_summary.json",
    "metrics_csv": "dataset_benchmark/robustness_v2/reports_recorded_noise/robustness_v2_recorded_noise_metrics.csv",
    "sample_level_csv": "dataset_benchmark/robustness_v2/reports_recorded_noise/robustness_v2_recorded_noise_sample_level.csv",
    "base_level_csv": "dataset_benchmark/robustness_v2/reports_recorded_noise/robustness_v2_recorded_noise_base_level.csv",
    "report_markdown": "dataset_benchmark/robustness_v2/reports_recorded_noise/robustness_v2_recorded_noise_report.md",
    "local_inference_audit": "dataset_benchmark/robustness_v2/reports_recorded_noise/local_inference_audit.json"
  },
  "execution": {
    "mode": "local_recorded_noise_c0_c3_inference",
    "requires_paid_api_confirmation": true,
    "confirmation_env_var": "ROBUSTNESS_V2_ALLOW_PAID_API",
    "confirmation_value": "YES_I_REVIEWED_THE_FULL_COST",
    "full_run_record_name": "recorded_noise_inference_run.json"
  }
}
